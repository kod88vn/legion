# ro.ps1 - drive the Ragnarok client like a player. All coordinates are GAME pixels = pixels of the screenshot
# (the client runs windowed at 1280x720 with DPI virtualization off, so 1 screenshot px = 1 game px).
#   ro.ps1 start                 launch the client (if not running) and wait for the window
#   ro.ps1 shot [name]           screenshot of the game area -> <scratch>\<name>.png (default "now"); prints path
#   ro.ps1 click X Y             left click        ro.ps1 rclick X Y   right click     ro.ps1 dclick X Y  double click
#   ro.ps1 hold X Y SECONDS      hold left button (keeps walking toward the cursor)
#   ro.ps1 drag X1 Y1 X2 Y2      drag (move windows, drag items)
#   ro.ps1 key NAME              ENTER ESC TAB SPACE BACK UP DOWN LEFT RIGHT INSERT F1..F12 ALT+x CTRL+x
#   ro.ps1 type "text"           type text into the focused field
#   ro.ps1 say "text"            public chat: Enter, type, Enter
#   ro.ps1 cmd "/sit"            same as say (slash commands / @commands)
#   ro.ps1 wait SECONDS
param([string]$Action, [string]$A, [string]$B, [string]$C, [string]$D)
$ErrorActionPreference = 'Stop'
$Scratch = if ($env:RO_SHOTS) { $env:RO_SHOTS } else { 'G:\RO\legion\tools\rogui\shots' }
New-Item -ItemType Directory -Force $Scratch | Out-Null
Add-Type -AssemblyName System.Drawing
if (-not ('RoP' -as [type])) {
Add-Type @"
using System; using System.Runtime.InteropServices;
public class RoP {
  [DllImport("user32.dll")] public static extern bool SetProcessDPIAware();
  [DllImport("user32.dll")] public static extern bool GetClientRect(IntPtr h, out RECT r);
  [DllImport("user32.dll")] public static extern bool ClientToScreen(IntPtr h, ref POINT p);
  [DllImport("user32.dll")] public static extern bool SetForegroundWindow(IntPtr h);
  [DllImport("user32.dll")] public static extern bool ShowWindow(IntPtr h, int c);
  [DllImport("user32.dll")] public static extern bool SetCursorPos(int x, int y);
  [DllImport("user32.dll")] public static extern void mouse_event(uint f, int dx, int dy, uint d, IntPtr e);
  [DllImport("user32.dll")] public static extern void keybd_event(byte vk, byte scan, uint f, IntPtr e);
  [DllImport("user32.dll")] public static extern short VkKeyScan(char c);
  [StructLayout(LayoutKind.Sequential)] public struct RECT { public int L, T, R, B; }
  [StructLayout(LayoutKind.Sequential)] public struct POINT { public int X, Y; }
}
"@
}
[RoP]::SetProcessDPIAware() | Out-Null

function Get-Win { Get-Process RO-AILab -ErrorAction SilentlyContinue | ? { $_.MainWindowHandle -ne 0 } | Select -First 1 }
function Get-Area($p) {
  $r = New-Object RoP+RECT; [RoP]::GetClientRect($p.MainWindowHandle, [ref]$r) | Out-Null
  $pt = New-Object RoP+POINT; [RoP]::ClientToScreen($p.MainWindowHandle, [ref]$pt) | Out-Null
  return [pscustomobject]@{ X = [int]$pt.X; Y = [int]$pt.Y; W = [int]$r.R; H = [int]$r.B }
}
function Focus($p) { [RoP]::ShowWindow($p.MainWindowHandle, 9) | Out-Null; [RoP]::SetForegroundWindow($p.MainWindowHandle) | Out-Null; Start-Sleep -Milliseconds 120 }
function Press([byte]$vk, [bool]$shift = $false) {
  if ($shift) { [RoP]::keybd_event(0x10, 0, 0, [IntPtr]::Zero) }
  [RoP]::keybd_event($vk, 0, 0, [IntPtr]::Zero); Start-Sleep -Milliseconds 40
  [RoP]::keybd_event($vk, 0, 2, [IntPtr]::Zero)
  if ($shift) { [RoP]::keybd_event(0x10, 0, 2, [IntPtr]::Zero) }
  Start-Sleep -Milliseconds 50
}
function TypeText([string]$s) { foreach ($ch in $s.ToCharArray()) { $v = [RoP]::VkKeyScan($ch); Press ([byte]($v -band 0xff)) (($v -band 0x100) -ne 0) } }
function MoveTo($p, [int]$x, [int]$y) { $ar = @(Get-Area $p)[-1]; [RoP]::SetCursorPos($ar.X + $x, $ar.Y + $y) | Out-Null; Start-Sleep -Milliseconds 120 }
function Btn([uint32]$down, [uint32]$up) { [RoP]::mouse_event($down, 0, 0, 0, [IntPtr]::Zero); Start-Sleep -Milliseconds 60; [RoP]::mouse_event($up, 0, 0, 0, [IntPtr]::Zero) }

if ($Action -eq 'start') {
  if (-not (Get-Win)) { & 'G:\RO\kRO-210607\client\ui-scale.ps1' -Width 1280 -Height 720; Start-Process -FilePath 'G:\RO\kRO-210607\client\Play-AILab.cmd' -WorkingDirectory 'G:\RO\kRO-210607\client' }
  for ($i = 0; $i -lt 60 -and -not (Get-Win); $i++) { Start-Sleep 1 }
  Start-Sleep 5; "started"; exit 0
}
if ($Action -eq 'wait') { Start-Sleep -Seconds ([double]$A); "ok"; exit 0 }
$p = Get-Win
if (-not $p) { "client not running (use: ro.ps1 start)"; exit 1 }
Focus $p
switch ($Action) {
  'shot' {
    $ar = @(Get-Area $p)[-1]; $name = if ($A) { $A } else { 'now' }
    $bmp = [System.Drawing.Bitmap]::new([int]$ar.W, [int]$ar.H)
    $g = [Drawing.Graphics]::FromImage($bmp); $g.CopyFromScreen($ar.X, $ar.Y, 0, 0, $bmp.Size)
    $out = Join-Path $Scratch "$name.png"; $bmp.Save($out, [Drawing.Imaging.ImageFormat]::Png); $g.Dispose(); $bmp.Dispose()
    "$out ($($ar.W)x$($ar.H))"
  }
  'click'  { MoveTo $p $A $B; Btn 2 4; "ok" }
  'rclick' { MoveTo $p $A $B; Btn 8 16; "ok" }
  'dclick' { MoveTo $p $A $B; Btn 2 4; Start-Sleep -Milliseconds 70; Btn 2 4; "ok" }
  'hold'   { MoveTo $p $A $B; [RoP]::mouse_event(2, 0, 0, 0, [IntPtr]::Zero); Start-Sleep -Seconds ([double]$C); [RoP]::mouse_event(4, 0, 0, 0, [IntPtr]::Zero); "ok" }
  'drag'   {
    MoveTo $p $A $B; [RoP]::mouse_event(2, 0, 0, 0, [IntPtr]::Zero); Start-Sleep -Milliseconds 100
    for ($i = 1; $i -le 10; $i++) { MoveTo $p ([int]$A + ([int]$C - [int]$A) * $i / 10) ([int]$B + ([int]$D - [int]$B) * $i / 10) }
    [RoP]::mouse_event(4, 0, 0, 0, [IntPtr]::Zero); "ok"
  }
  'key' {
    $map = @{ ENTER = 0x0D; ESC = 0x1B; TAB = 0x09; SPACE = 0x20; BACK = 0x08; UP = 0x26; DOWN = 0x28; LEFT = 0x25; RIGHT = 0x27; INSERT = 0x2D
              F1 = 0x70; F2 = 0x71; F3 = 0x72; F4 = 0x73; F5 = 0x74; F6 = 0x75; F7 = 0x76; F8 = 0x77; F9 = 0x78; F10 = 0x79; F11 = 0x7A; F12 = 0x7B }
    if ($A -match '^(ALT|CTRL)\+(.)$') {
      $mod = if ($Matches[1] -eq 'ALT') { 0x12 } else { 0x11 }
      [RoP]::keybd_event($mod, 0, 0, [IntPtr]::Zero); $v = [RoP]::VkKeyScan($Matches[2].ToLower()[0]); Press ([byte]($v -band 0xff)); [RoP]::keybd_event($mod, 0, 2, [IntPtr]::Zero)
    } elseif ($map.ContainsKey($A)) { Press ([byte]$map[$A]) } else { "unknown key $A"; exit 1 }
    "ok"
  }
  'type' { TypeText $A; "ok" }
  { $_ -in 'say', 'cmd' } { Press 0x0D; Start-Sleep -Milliseconds 150; TypeText $A; Press 0x0D; "ok" }
  default { "unknown action $Action"; exit 1 }
}
