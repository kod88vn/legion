# copy to .env and fill in
# docker compose settings (read automatically)
# player profiles (personas) and how many may be online at once
LEGION_BOTS=
LEGION_MAX_ONLINE=
# optional fallback mastermind container only (normally Claude Code / Copilot agents drive the LLM layer)
# ANTHROPIC_API_KEY=

# Ayla's party members: the names legion-core runs (legion excludes them). Both services read this: must match.
# The current names and their classes are kept in docs/rules/ayla.md.
LEGION_CORE="example_core_1,example_core_2,example_core_3,example_core_4"

# Durable hourly cohort admission gate: when true, limits new bot admissions to 100 per hour.
# Default: false (gate disabled, all bots admit normally). Set only after owner approval.
# DURABLE_COHORT_ENABLED=false
# DURABLE_COHORT_FLAG=-durable-cohort

