# Git tracks the AI harness; runtime state, logs, backups and big media stay on disk only.

# backups and scratch
backups/
*.bak
*.bak[0-9]*
*.bak-*
*.before-*
__pycache__/
*.pyc
tools/.state/

# logs and container state
openkore/logs/
openkore-ayla/logs/
openkore-qa/logs/
mastermind/state/
*.log

# engine runtime state (legion/data): written by the running engine
legion/data/backup-*/
legion/data/memory/
legion/data/parties*.json
legion/data/friends*.json
legion/data/minds.json
legion/data/levels.json
legion/data/levels.core.json
legion/data/meter_bots.json
legion/data/overview.json
legion/data/char_levels.json
legion/data/resets_pending*.json
legion/data/markdowns*.json
legion/data/human-*.json
legion/data/party-turns.json
legion/data/guild_roster.json
legion/data/guild_leaders.json
legion/data/alchemists.json
legion/data/brewers.json
legion/data/shoptitles.json
legion/data/trace.txt
legion/data/meter.jsonl
legion/data/meter_state*.json.gz
legion/data/.meter_state*.tmp
legion/data/goroutines-*.txt

# compiled binaries
legion/legion
legion/legion.exe
*.exe

# demo screenshots (multi-MB)
/*.png

# watch-view screenshots and temp files
tools/rogui/shots/
tools/rogui/tmp/

# puppet harness runtime
legion/data/puppet_calls.jsonl
legion/data/puppet_heartbeat.json*
legion/data/puppet.pause
legion/data/ayla_orders.jsonl
legion/data/bugqueue.jsonl
# logins kept out of the tracked personas.json (ayla-switch): account id -> password
legion/data/logins.local.json
legion/data/neo.wake
legion/data/build.wake
legion/data/guild_duty.json
legion/data/guild_rank.json

# system-agent harness runtime (tools/system, tools/sentinel.py, tools/mindgate.py, tools/deploy)
legion/data/*.heartbeat
legion/data/stack.up
legion/data/stack.hold
legion/data/bugq.watch.json
legion/data/mindgate.state.json
legion/data/deploys.jsonl
legion/data/rathena_recreates.jsonl
legion/data/econ_counters*.json
tools/mindgate.paused
docs/reports/league-*.md
tools/puppet/workdir/.claude/

# rathena copies used as gen_mapdensity.py input (conf/ and npc/ from ro-rathena; local only, see the generator docstring)
tools/dev/rathena-*/
legion/testdata/rathena/
legion/data/lfgstats.json
# map-truth snapshot of the server data (tools/system/fieldcheck.py refreshes it: read-only copy of ro-rathena)
tools/dev/mapsnap/
legion/data/owner.token
